# Sahid AI Hub — environment variable NAMES only. Copy to .env.local and fill in.
# Never commit .env.local or paste real values here.

# --- Authentication (required for /dashboard; if any are missing, access is DENIED) ---
# Generate a random secret:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# GitHub OAuth App (github.com/settings/developers). Callback URL:
#   <site-origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Owner allowlist: comma-separated NUMERIC GitHub user IDs (not usernames).
# Look yours up at https://api.github.com/users/<username> ("id").
OWNER_GITHUB_IDS=

# --- GitHub integration (/dashboard/github) ---
# Fine-grained personal access token, read-only (Metadata: read, Contents: read)
# on the repositories listed in data/project-registry.ts.
GITHUB_TOKEN=

# --- Vercel integration (/dashboard/vercel, /dashboard/live-apps) ---
# Token from vercel.com/account/tokens with read access to the projects.
VERCEL_TOKEN=
# Only for projects under a team (team_...).
VERCEL_TEAM_ID=

# --- Notion integration (/dashboard/notion) ---
# Internal integration token with "Read content" capability only.
NOTION_TOKEN=
# Access is limited to exactly these IDs (32-char, dashes optional), comma-separated.
# Share only these pages/databases with the integration in Notion.
NOTION_DATA_SOURCE_IDS=
NOTION_PAGE_IDS=
# Optional override of the Notion-Version header (default 2025-09-03).
NOTION_API_VERSION=
