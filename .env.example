# GitHub Integration
# Username to display on the /github dashboard
GITHUB_USERNAME=sahidattaf

# Optional: Personal Access Token (read-only, public repos only)
# Without this, the GitHub API allows 60 requests/hour per IP.
# With this, the limit increases to 5000 requests/hour.
# Generate at: https://github.com/settings/tokens
# Required scopes: none (public data only)
GITHUB_TOKEN=

# Vercel Integration
# Required: Personal access token — generate at vercel.com/account/tokens
# Required scopes: read projects and deployments
VERCEL_TOKEN=

# Optional: Team ID (team_…) — only needed if your projects are under a Vercel team
# Find it in vercel.com/teams/<your-team>/settings
VERCEL_TEAM_ID=

# Notion Integration (data/projects.ts reads the Project Registry server-side)
# Internal integration secret: notion.so/profile/integrations. Then share the
# "Project Registry" database with that integration (••• > Connections).
NOTION_TOKEN=
# Database id (32 hex chars) or the database URL.
NOTION_DATABASE_ID=

# Optional Owner Dashboard (/owner). Set these in server-side environment variables.
# GitHub OAuth app callback: <app origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Use a freshly generated random secret for each environment.
AUTH_SECRET=
# Canonical app origin, for example http://localhost:3000 during local development.
AUTH_URL=
# Numeric GitHub account ID for the authorized owner.
OWNER_GITHUB_ID=
